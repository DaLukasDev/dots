tm() {
  if (( $# != 1 )); then
    print -u2 "Usage: tm <script-name>"
    return 2
  fi

  local script_name="$1"
  local scripts_dir="$HOME/.dotfiles/scripts/tmux"
  local script="$scripts_dir/$script_name"

  if [[ "$script_name" == */* ]]; then
    print -u2 "tm: script name must not contain '/'"
    return 2
  fi

  if [[ ! -f "$script" ]]; then
    print -u2 "tm: no script named '$script_name' in $scripts_dir"

    local candidate
    local -a available_scripts
    for candidate in "$scripts_dir"/*(N.); do
      [[ -x "$candidate" ]] && available_scripts+=("${candidate:t}")
    done

    if (( ${#available_scripts} )); then
      print -u2 "Available scripts: ${available_scripts[*]}"
    fi

    return 1
  fi

  if [[ ! -x "$script" ]]; then
    print -u2 "tm: '$script' is not executable (run: chmod +x '$script')"
    return 126
  fi

  "$script"
}
